# --- Postgres (Drizzle) — Settings → Database → Connection string ---
# Runtime: Transaction pooler, port 6543, ?pgbouncer=true
DATABASE_URL=postgresql://postgres.qmtcnmrjvnvurgxrskmh:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations only: Session pooler, port 5432
DIRECT_URL=postgresql://postgres.qmtcnmrjvnvurgxrskmh:[YOUR-DB-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- Supabase API (optional; not used by Drizzle today) ---
NEXT_PUBLIC_SUPABASE_URL=https://qmtcnmrjvnvurgxrskmh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Clerk (Development keys on localhost; Production on Vercel main) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# --- Go-Ai gateway (server-only) ---
GO_AI_BASE_URL=https://...
GO_AI_SHARED_SECRET=...

# --- Web Push (task notifications on phone) ---
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@okhanahome.com

# Optional — SEO canonical base
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cron (Vercel Cron → /api/cron/*) ---
# Shared secret; Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

